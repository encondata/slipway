# Terraform's CLI config in the Slipway image (SLIPWAY_TERRAFORM_CLI_CONFIG points here).
# Providers come only from the image's filesystem mirror, which holds the checksummed bpg/proxmox
# zip, so `terraform init` never goes online and can't pick up a provider nobody checked.
disable_checkpoint = true
provider_installation {
  filesystem_mirror {
    path    = "/opt/terraform/providers"
    include = ["registry.terraform.io/bpg/proxmox"]
  }
  direct { exclude = ["*/*"] }
}
